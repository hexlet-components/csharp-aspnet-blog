{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=blog.db"
  },
  "Jwt": {
    "SecretKey": "dev-only-key-replace-through-Jwt__SecretKey-env",
    "Issuer": "csharp-aspnet-blog",
    "Audience": "csharp-aspnet-blog",
    "ExpiresMinutes": 60
  }
}
